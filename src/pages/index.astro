---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookCTA from '../components/BookCTA.astro';
import BrowserFrame from '../components/BrowserFrame';
import OperatorWindow from '../components/OperatorWindow';
---

<BaseLayout title="Green Loom" description="Two systems. One operation.">
	<Header />
	<main class="gl-marketing">
		<!-- HERO -->
		<section class="hero" id="hero">
			<div class="hero__inner">
				<h1 class="hero__title">
					<span class="u-lime">Unfuck</span> your shit.
				</h1>
				<p class="hero__sub">
					Two systems that don’t talk. Order vs shelf.
				</p>
				<div class="hero__cta">
					<BookCTA href="#book" />
				</div>
			</div>

			<!-- WINDOW: 44rem 1:1, browser bezel + title bar glass only, clear viewport -->
			<div class="hero__window">
				<BrowserFrame width="44rem" height="44rem">
					<OperatorWindow />
				</BrowserFrame>
			</div>
		</section>

		<!-- BODY: exactly two short sections -->
		<section class="section" id="systems">
			<div class="section__inner">
				<h2>Two systems that don’t talk.</h2>
				<p>
					One side takes the order. The other side manages what’s on the shelf.
					They run in parallel and never meet. Every handoff is a rekey, a guess,
					or a walk across the floor.
				</p>
			</div>
		</section>

		<section class="section" id="shelf">
			<div class="section__inner">
				<h2>Order vs shelf. (Package)</h2>
				<p>
					An order is a request. The shelf is what actually exists. Package keeps
					those two honest—without turning the floor into a game of telephone.
				</p>
			</div>
		</section>

		<!-- FINAL CTA -->
		<section class="cta-band" id="book">
			<div class="cta-band__inner">
				<h2>Ready to see it in your store?</h2>
				<BookCTA />
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>

<style>
	.hero {
		background: #0a0b09;
		color: #e6e6e3;
		padding: 4.5rem 1.25rem 3rem;
		text-align: center;
	}

	.hero__inner {
		max-width: 42rem;
		margin: 0 auto 2rem;
	}

	.hero__title {
		font-size: clamp(2.75rem, 6vw, 4.25rem);
		line-height: 1.05;
		font-weight: 700;
		letter-spacing: -0.03em;
		margin: 0 0 0.75rem;
	}

	.u-lime {
		/* lime-to-white gradient on "Unfuck" */
		background: linear-gradient(90deg, #a3e635, #f4f4f2 70%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero__sub {
		font-size: clamp(1.05rem, 1.6vw, 1.35rem);
		color: #b8b8b3;
		max-width: 36rem;
		margin: 0 auto 1.25rem;
		line-height: 1.35;
	}

	.hero__cta {
		margin-top: 0.5rem;
	}

	.hero__window {
		display: flex;
		justify-content: center;
		margin-top: 1.5rem;
	}

	.section {
		background: #0a0b09;
		color: #e6e6e3;
		padding: 3.25rem 1.25rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.section__inner {
		max-width: 42rem;
		margin: 0 auto;
	}

	.section h2 {
		font-size: clamp(1.35rem, 2.2vw, 1.65rem);
		line-height: 1.15;
		margin: 0 0 0.6rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.section p {
		color: #b8b8b3;
		font-size: 1.02rem;
		line-height: 1.55;
		margin: 0;
		max-width: 38rem;
	}

	.cta-band {
		background: #0a0b09;
		color: #e6e6e3;
		padding: 3rem 1.25rem 4rem;
		text-align: center;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.cta-band__inner {
		max-width: 36rem;
		margin: 0 auto;
	}

	.cta-band h2 {
		font-size: 1.35rem;
		margin: 0 0 1rem;
		font-weight: 600;
	}

	@media (max-width: 820px) {
		.hero__window {
			transform: scale(0.92);
			transform-origin: top center;
		}
	}

	/* Ensure the square frame stays 44rem on wide screens without live crop */
	@media (min-width: 820px) {
		.hero__window :global(.op-window),
		.hero__window :global(.browser-frame) {
			width: 44rem !important;
			height: 44rem !important;
		}
	}
</style>
