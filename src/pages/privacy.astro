---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Privacy · Green Loom" description="Green Loom privacy notice.">
	<Header />
	<main class="mkt-privacy">
		<h1>Privacy</h1>
		<p>
			Green Loom does not collect personal information on this marketing site except where
			explicitly provided for updates. No age gates, lab claims, or license assertions are
			made without a source.
		</p>
		<p>
			When a follow form or booking form is added, this page will name the processor and
			retention details.
		</p>
		<p><a href="/">Back to Green Loom</a></p>
	</main>
	<Footer />
</BaseLayout>

<style>
	.mkt-privacy {
		max-width: 42rem;
		margin: 0 auto;
		padding: 3rem 1.25rem 4rem;
		color: #e6e6e3;
		background: #0a0b09;
	}
	.mkt-privacy h1 {
		font-size: 1.6rem;
		margin: 0 0 1rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.mkt-privacy p {
		color: #b8b8b3;
		line-height: 1.55;
		margin: 0 0 0.9rem;
	}
	.mkt-privacy a {
		color: #a3e635;
	}
</style>
